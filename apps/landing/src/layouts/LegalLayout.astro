---
import Layout from './Layout.astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'OeRifa | Aviso Legal',
  description = 'Términos legales y políticas de privacidad de OeRifa.',
} = Astro.props;
---

<Layout {title} {description}>
  <main class="max-w-[1000px] mx-auto bg-white rounded-[2.5rem] md:rounded-[3.5rem] shadow-sm relative overflow-hidden">
    <nav class="flex justify-between items-center px-8 md:px-16 py-8 border-b border-gray-100">
      <div class="flex items-center gap-2">
        <img src="/logo.svg" alt="OeRifa" class="h-8 w-auto" />
      </div>
      <a href="/" class="flex items-center gap-2 font-mono text-xs uppercase tracking-wide font-bold text-gray-500 hover:text-app-accent transition-colors">
        <i class="ph-bold ph-arrow-left text-base"></i> Volver al inicio
      </a>
    </nav>

    <slot />

    <footer class="bg-[#F8F9F5] px-8 md:px-16 py-12 border-t border-gray-100 flex flex-col md:flex-row justify-between items-center gap-6">
      <span class="font-mono text-[10px] uppercase tracking-widest text-gray-500">© 2026 OeRifa</span>
      <div class="flex gap-6">
        <a href="/aviso-legal" class="font-mono text-xs uppercase font-bold text-gray-600 hover:text-app-accent transition-colors">Aviso Legal y Privacidad</a>
        <a href="/terminos" class="font-mono text-xs uppercase font-bold text-gray-600 hover:text-app-accent transition-colors">Términos y Condiciones</a>
      </div>
    </footer>
  </main>
</Layout>
